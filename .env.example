# Copy to .env.local and fill in. Never commit real secrets.

# --- NFT data adapter ---
# "mock" = generated fake Chogs (no chain needed), "onchain" = real reads from Monad
NFT_ADAPTER=mock
# Mock mode only: collection size, and a wallet that owns tokens 1-10 (to test defending)
MOCK_SUPPLY=4444
MOCK_OWNER_ADDRESS=

# --- Chain (Monad) ---
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=Monad
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=

# --- Chog NFT collection ---
NEXT_PUBLIC_CHOG_CONTRACT_ADDRESS=
# Optional override if tokenURI metadata/images need a gateway (e.g. IPFS)
CHOG_METADATA_GATEWAY=

# --- Wallet connection ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Auth (sign-in-with-wallet session signing) ---
SESSION_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- $CHOG token bonus (optional, off by default) ---
NEXT_PUBLIC_FEATURE_CHOG_TOKEN=false
# $CHOG ERC-20 on Monad (the token, NOT the NFT collection)
NEXT_PUBLIC_CHOG_TOKEN_ADDRESS=0x350035555E10d9AfAF1566AaebfCeD5BA6C27777
