# Copy to .env.local and fill in. Never commit real secrets.

# --- NFT data adapter ---
# "onchain" = real Chog Genesis reads on Monad, "mock" = generated Chogs (no chain, offline fallback)
NFT_ADAPTER=onchain
# Mock mode only: collection size, and a wallet that owns tokens 1-10 (to test defending)
MOCK_SUPPLY=1969
MOCK_OWNER_ADDRESS=

# --- Chain (Monad mainnet) ---
NEXT_PUBLIC_CHAIN_ID=143
NEXT_PUBLIC_CHAIN_NAME=Monad
NEXT_PUBLIC_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://monadscan.com

# --- Chog NFT collection: "Chog Genesis" (ERC-721, token ids 1-1969) ---
NEXT_PUBLIC_CHOG_CONTRACT_ADDRESS=0xc96d31f8626c6d03fae5dcd3d61e3fb9f4a73763
# tokenURI and image fields are ipfs:// URIs. Gateways tried in order (comma separated).
CHOG_IPFS_GATEWAYS=https://ipfs.filebase.io/ipfs/,https://gateway.pinata.cloud/ipfs/
# Where downloaded artwork is cached (art never changes)
CHOG_CACHE_DIR=.cache

# --- Wallet connection ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Auth (Sign-In with Ethereum sessions) ---
# 32+ random characters. Required in production; dev falls back to a random per-run secret.
SESSION_SECRET=
# Mock mode only: show a "Demo owner" sign-in (owns MOCK_OWNER_ADDRESS's Chogs 1-10). See npm run dev:mock.
DEMO_SIGNIN=0

# --- Storage ---
# With Supabase vars set, raids are stored in Postgres (run supabase/migrations/*.sql first).
# Without them, a local JSON file in DATA_DIR is used (fine for dev and single-server demos).
DATA_DIR=.data

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- $CHOG token bonus (optional, off by default) ---
NEXT_PUBLIC_FEATURE_CHOG_TOKEN=false
# $CHOG ERC-20 on Monad (the token, NOT the NFT collection)
NEXT_PUBLIC_CHOG_TOKEN_ADDRESS=0x350035555E10d9AfAF1566AaebfCeD5BA6C27777
